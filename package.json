{
  "name": "setup-openmodelica",
  "description": "Setup OpenModelica Compiler omc",
  "version": "1.1.0",
  "author": "Andreas Heuermann",
  "license": "OSMC-PL-1-8",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "ci-test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenModelica/setup-openmodelica.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-stylistic": "^0.0.0-0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "js-yaml": "^5.4.2",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.2",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/OpenModelica/setup-openmodelica/issues"
  },
  "homepage": "https://github.com/OpenModelica/setup-openmodelica#readme"
}
